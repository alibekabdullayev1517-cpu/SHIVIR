[Unit]
Description=Shivir sender web (FastAPI/uvicorn)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=shivir
WorkingDirectory=/opt/shivir
EnvironmentFile=/opt/shivir/.env
ExecStart=/opt/shivir/.venv/bin/uvicorn web.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
