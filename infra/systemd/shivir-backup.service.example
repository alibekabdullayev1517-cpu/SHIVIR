[Unit]
Description=Shivir Postgres backup
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=shivir
WorkingDirectory=/opt/shivir
Environment=ENV_FILE=/opt/shivir/.env
Environment=BACKUP_DIR=/var/backups/shivir
ExecStart=/opt/shivir/infra/backup.sh

# Sandboxing: unlike the app services, this one genuinely needs one write
# path (BACKUP_DIR) alongside read access to .env and the network route to
# Postgres — otherwise as locked down as the rest of infra/systemd/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/shivir
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
