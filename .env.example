# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
ENV=development
LOG_LEVEL=INFO

# 64+ char random string used for HMAC (sender fingerprint hashing, CSRF tokens).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# --- Telegram ---
# From @BotFather. Required for bot/workers to run; never hardcode.
BOT_TOKEN=

# Username of the bot (without @), used to build t.me deep links.
BOT_USERNAME=shivirbot

# --- Public web ---
# Public base URL of the sender web page (used in generated links / share cards).
WEB_BASE_URL=http://localhost:8000

# --- Database ---
# Async SQLAlchemy URL. Postgres for real deployments, sqlite+aiosqlite for local/dev tests.
DATABASE_URL=postgresql+asyncpg://shivir:shivir@localhost:5432/shivir

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting (per-window counters) ---
RATE_LIMIT_SEND_PER_FINGERPRINT=5
RATE_LIMIT_SEND_PER_FINGERPRINT_WINDOW_SECONDS=300
RATE_LIMIT_SEND_PER_LINK=30
RATE_LIMIT_SEND_PER_LINK_WINDOW_SECONDS=300
RATE_LIMIT_SEND_GLOBAL=2000
RATE_LIMIT_SEND_GLOBAL_WINDOW_SECONDS=60

# --- Moderation ---
# Report count at which a link is auto-disabled pending review.
LINK_AUTO_DISABLE_REPORT_THRESHOLD=5

# Comma-separated Telegram user IDs allowed to review the moderation queue via bot
# commands (V1 has no separate admin web dashboard). Example: 111111111,222222222
ADMIN_TG_USER_IDS=
